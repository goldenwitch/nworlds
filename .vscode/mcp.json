{
  "servers": {
    "nworlds-observation": {
      "type": "stdio",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/mcp-launch.ps1",
        "-ManifestPath",
        "${workspaceFolder}/crates/voxel-sample/Cargo.toml",
        "-BinaryName",
        "voxel-observer-mcp"
      ]
    },
    "caravan-observation": {
      "type": "stdio",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/mcp-launch.ps1",
        "-ManifestPath",
        "${workspaceFolder}/crates/caravan-sample/Cargo.toml",
        "-BinaryName",
        "caravan-observer-mcp"
      ]
    }
  }
}

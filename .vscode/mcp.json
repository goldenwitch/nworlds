{
  "servers": {
    "nworlds-observation": {
      "type": "stdio",
      "command": "cargo",
      "args": [
        "run",
        "--quiet",
        "--manifest-path",
        "${workspaceFolder}/crates/voxel-sample/Cargo.toml",
        "--bin",
        "voxel-observer-mcp",
        "--"
      ]
    },
    "caravan-observation": {
      "type": "stdio",
      "command": "cargo",
      "args": [
        "run",
        "--quiet",
        "--manifest-path",
        "${workspaceFolder}/crates/caravan-sample/Cargo.toml",
        "--bin",
        "caravan-observer-mcp",
        "--"
      ]
    }
  }
}
